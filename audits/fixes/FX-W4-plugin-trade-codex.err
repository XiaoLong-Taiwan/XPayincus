diff --git a/server/src/routes/admin-plugins.ts b/server/src/routes/admin-plugins.ts
index a82c8676e6cc855ee8c3b5e4d2c817d7625dbba1..86d50dd050aa70794af2f780f238eee19a4c8e49
--- a/server/src/routes/admin-plugins.ts
+++ b/server/src/routes/admin-plugins.ts
@@ -34,6 +34,7 @@
 import type { XPayincusPluginManifest, PluginConfigFieldManifest } from '../lib/plugin-manifest.js'
