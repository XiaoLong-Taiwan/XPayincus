 await fastify.register(themeMarketSubmissionRoutes, { prefix: '/api/theme-market-submissions' })
 await fastify.register(apiTokenRoutes, { prefix: '/api/api-tokens' })
 await fastify.register(publicApiRoutes, { prefix: '/api/v1' })
