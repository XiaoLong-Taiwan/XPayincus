diff --git a/server/package.json b/server/package.json
index 55f1ff39ea35261702bbcd35e420eb5993582fe2..f6a4d9710eeefc8de4adee47b20e2dab17e0e2d1
--- a/server/package.json
+++ b/server/package.json
@@ -113,6 +113,7 @@
     "test:plugin-package-guards": "node --import tsx scripts/test-plugin-package-guards.ts",
     "test:plugin-market-guards": "node --import tsx scripts/test-plugin-market-guards.ts",
     "test:plugin-market-governance-guards": "node --import tsx scripts/test-plugin-market-governance-guards.ts",
+    "test:plugin-trade-guards": "node --import tsx scripts/test-plugin-trade-guards.ts",
