        if (!locked) {
          throw new Error('æ‰˜ç®¡ä½™é¢æ­£åœ¨å¤„ç†ï¼Œè¯·ç¨åŽé‡è¯•')
        }
        if (isBalanceTransfer) {
          const balanceLocked = await tryAdvisoryTransactionLock(tx, USER_BALANCE_LOCK_NAMESPACE, user.id)
          if (!balanceLocked) {
            throw new Error('ç”¨æˆ·ä½™é¢æ­£åœ¨å¤„ç†ï¼Œè¯·ç¨åŽé‡è¯•')
          }
        }

        // æ‰£å‡æ‰˜ç®¡ä½™é¢
