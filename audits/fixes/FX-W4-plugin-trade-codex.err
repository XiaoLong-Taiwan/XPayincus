  host_offline
  agent_offline
  resource_pressure
  plan_upgrade_sync_failed
}

enum DeliveryAssuranceActionType {
  detected
  retry
  takeover
  notify_user
  mark_recovered
  close
}

enum SlaAlertSeverity {
  info
  warning
  critical
}

enum SlaAlertStatus {
  open
  investigating

