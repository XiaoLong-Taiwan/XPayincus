    "test:installer": "bash scripts/test-install-panel-guards.sh",
    "test:demo-account-safety-guards": "pnpm --filter server test:demo-account-safety-guards",
    "test:demo-notification-redaction-guards": "pnpm --filter server test:demo-notification-redaction-guards",
    "test:demo-readonly-redaction-guards": "pnpm --filter server test:demo-readonly-redaction-guards"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": "^2.10.38",
      "caniuse-lite": "^1.0.30001799"
    }
  },
  "packageManager": "pnpm@9.14.2"
}

