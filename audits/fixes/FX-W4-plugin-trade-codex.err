+enum PluginPurchaseStatus {
+  completed
+  refunded
+}
+
+enum PluginLicenseStatus {
+  active
+  revoked
+}
+
+enum PluginRefundStatus {
+  completed
+}
+
+enum PluginDeveloperEarningStatus {
+  pending
+  reversed
+}
+
+enum PluginDeveloperWithdrawalStatus {
+  pending
+  completed
+  rejected
+}
+
+// ==================== 恢复任务模型 ====================
+
 model RestoreTask {
   id                   Int               @id @default(autoincrement())
   instanceId           Int               @map("instance_id")
