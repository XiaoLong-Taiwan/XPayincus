  confirmed      // 已确认
  compensated    // 已补偿
  closed         // 已关闭
}

enum FinancialReconciliationStatus {
  normal      // 正常
  discrepancy // 差异
  confirmed   // 已确认
  ignored     // 已忽略
}

enum FinancialReconciliationItemType {
