  499:         additionalProperties: false
  500:       }
  501:     }
  502:   }, async (request, reply) => {
  503:     const instanceId = parsePositiveRouteId(request.params.id)
  504: 
  505:     if (!instanceId) {
  506:       return reply.code(400).send(apiError(ErrorCode.INVALID_ID))
  507:     }
  508: 
  509:     return reply.code(403).send(apiError(ErrorCode.FORBIDDEN, 'è¯¥åŠŸèƒ½å·²ä¸‹çº¿'))
  510:   })
  511: 
  512:   // ==================== æ‰‹åŠ¨ç»­è´¹ ====================
  513:   // POST /api/instances/:id/renew
  514:   fastify.post<{
  515:     Params: { id: string }
  516:     Body: { months: number }
  517:   }>('/:id/renew', {
  518:     onRequest: [fastify.authenticateUser],
  519:     config: { rateLimit: { max: 10, timeWindow: '1 minute' } },
  520:     schema: {
  521:       body: {
  522:         type: 'object',
  523:         required: ['months'],
  524:         properties: {
  525:           months: { type: 'integer', minimum: 1, maximum: 24 }
  526:         }
  527:       }
  528:     }
  529:   }, async (request, reply) => {
  530:     const { user } = request
  531:     const instanceId = parsePositiveRouteId(request.params.id)
  532:     const { months } = request.body
  533: 
  534:     if (!instanceId) {
  535:       return reply.code(400).send(apiError(ErrorCode.INVALID_ID))
  536:     }
  537: 
  538:     const instance = await prisma.instance.findUnique({
  539:       where: { id: instanceId }
  540:     })
  541: 
  542:     if (!instance) {
  543:       return reply.code(404).send(apiError(ErrorCode.INSTANCE_NOT_FOUND))
  544:     }
  545: 
  546:     // åªæœ‰å®žä¾‹æ‰€æœ‰è€…å¯ä»¥ç»­è´¹
  547:     if (instance.userId !== user.id) {
  548:       return reply.code(403).send(apiError(ErrorCode.FORBIDDEN))
  549:     }
  550: 
  551:     if (instance.status === 'deleted') {
  552:       return reply.code(400).send({ error: 'å®žä¾‹å·²åˆ é™¤ï¼Œæ— æ³•ç»­è´¹', code: 'INSTANCE_DELETED' })
  553:     }
  554: 
  555:     // å…è´¹å®žä¾‹æ— éœ€ç»­è´¹
  556:     if (!instance.packagePlanId) {
  557:       return reply.code(400).send({ error: 'å…è´¹å®žä¾‹æ— éœ€ç»­è´¹', code: 'FREE_INSTANCE' })
  558:     }
  559: 
  560:     if (await checkExchangeBillingLock(instanceId, reply)) return
  561: 
  562:     // æ£€æŸ¥æ˜¯å¦ä¸ºç”¨æˆ·æ‰˜ç®¡èŠ‚ç‚¹çš„ç»­è´¹é™åˆ¶
  563:     const host = await prisma.host.findUnique({
  564:       where: { id: instance.hostId },
  565:       select: {
  566:         user: {
  567:           select: {
  568:             role: true
  569:           }
  570:         }
  571:       }
  572:     })
  573:     const isHostedInstance = host?.user.role === 'user'
  574:     if (isHostedInstance) {
  575:       // ç”¨æˆ·æ‰˜ç®¡èŠ‚ç‚¹çš„å®žä¾‹åªèƒ½ç»­è´¹1ä¸ªæœˆ
  576:       if (months !== 1) {
  577:         return reply.code(400).send({
  578:           error: 'ç”¨æˆ·æ‰˜ç®¡èŠ‚ç‚¹çš„å®žä¾‹ä»…æ”¯æŒæŒ‰æœˆç»­è´¹',
  579:           code: 'HOSTING_MONTHLY_ONLY'
  580:         })
  581:       }
  582:       
  583:       // åªèƒ½åœ¨åˆ°æœŸå‰7å¤©å†…ç»­è´¹
  584:       if (instance.expiresAt) {
  585:         const now = new Date()
  586:         const daysUntilExpire = Math.ceil((instance.expiresAt.getTime() - now.getTime()) / (1000 * 60 * 60 * 24))
  587:         if (daysUntilExpire > 7) {
  588:           return reply.code(400).send({
  589:             error: `ç”¨æˆ·æ‰˜ç®¡èŠ‚ç‚¹çš„å®žä¾‹ä»…å¯åœ¨åˆ°æœŸå‰7å¤©å†…ç»­è´¹ï¼ˆå½“å‰å‰©ä½™ ${daysUntilExpire} å¤©ï¼‰`,
  590:             code: 'HOSTING_RENEW_TOO_EARLY'
  591:           })
  592:         }
  593:       }
  594:     }
  595: 
  596:     try {
  597:       const result = await db.performRenewal(user.id, instance, months)
  598: 
  599:       // å‘é€ç»­è´¹æˆåŠŸé€šçŸ¥
  600:       await sendNotification(user.id, 'instance_renewed', {
  601:         instanceName: instance.name,
  602:         renewAmount: result.amount, // å…ƒï¼ˆperformRenewal è¿”å›žçš„æ˜¯å…ƒï¼‰
  603:         renewMonths: months,
  604:         newExpiresAt: result.newExpiresAt.toISOString()
  605:       })
  606:       
  607:       // å‘é€æ‰˜ç®¡æ”¶å…¥é€šçŸ¥ç»™èŠ‚ç‚¹æ‰€æœ‰è€…ï¼ˆä»…å‘é€åˆ°å¤–éƒ¨æ¸ é“ï¼Œä¸åˆ›å»ºç«™å†…ä¿¡ï¼‰
  608:       if (result.hostingIncomeResult) {
  609:         sendHostManagedInstanceNotification(
  610:           instance.hostId,
  611:           'renew',
  612:           {
  613:             username: user.username,
  614:             instanceName: instance.name,
  615:             amount: result.amount
  616:           }
  617:         ).catch(err => {
  618:           console.warn(`[ç»­è´¹] å‘é€æ‰˜ç®¡æ”¶å…¥é€šçŸ¥å¤±è´¥:`, err)
  619:         })
  620:       }
  620:       }
  621: 
  622:       // å‘é€ç»­è´¹æˆåŠŸé‚®ä»¶é€šçŸ¥
  623:       try {
  624:         const userInfo = await db.findUserById(user.id)
  625:         if (userInfo && userInfo.email) {
  626:           await sendRenewSuccessEmail(userInfo.email, {
  627:             username: userInfo.username,
  628:             instanceName: instance.name,
  629:             amount: result.amount,
  630:             months,
  631:             newExpiresAt: result.newExpiresAt
  632:           })
  633:         }
  634:       } catch (emailErr) {
  635:         // é‚®ä»¶å¤±è´¥ä¸å½±å“ä¸»æµç¨‹
  636:         console.warn(`[ç»­è´¹] å‘é€ç»­è´¹æˆåŠŸé‚®ä»¶å¤±è´¥:`, emailErr)
  637:       }
  638: 
  639:       await createLog(
  640:         user.id,
  641:         'instance',
  642:         'instance.renew',
  643:         `Renewed instance "${instance.name}" for ${months} month(s), amount: ${result.amount}`,
  644:         'success',
  645:         { instanceId }
  646:       )
  647: 
  648:       return {
  649:         message: 'ç»­è´¹æˆåŠŸ',
  650:         amount: result.amount,
  651:         months,
  652:         newExpiresAt: result.newExpiresAt.toISOString()
  653:       }
  654:     } catch (error) {
  655:       const errorMessage = error instanceof Error ? error.message : 'ç»­è´¹å¤±è´¥'
  656:       return reply.code(400).send({ error: errorMessage })
  657:     }
  658:   })
  659: 
  660:   fastify.post<{
  661:     Body: { instanceIds: number[] }
  662:   }>('/batch/renew-preview', {
  663:     onRequest: [fastify.authenticateUser],
  664:     config: { rateLimit: { max: 10, timeWindow: '1 minute' } },
  665:     schema: {
  666:       body: {
  667:         type: 'object',
  668:         required: ['instanceIds'],
  669:         properties: {
  670:           instanceIds: {
  671:             type: 'array',
  672:             items: { type: 'integer' },
  673:             minItems: 1,
  674:             maxItems: 100
  675:           }
  676:         },
  677:         additionalProperties: false
  678:       }
  679:     }
  680:   }, async (request, reply) => {
  681:     const uniqueIds = Array.from(new Set(request.body.instanceIds)).filter(id => Number.isInteger(id))
  682:     if (uniqueIds.length === 0) {
  683:       return reply.code(400).send({ error: 'è¯·é€‰æ‹©è‡³å°‘ä¸€ä¸ªå®žä¾‹' })
  684:     }
  685: 
  686:     const items = await Promise.all(uniqueIds.map(id => buildBatchRenewPreviewItem(request.user.id, id)))
  687:     return { items }
  688:   })
  689: 
  690:   fastify.post<{
  691:     Body: { instanceIds: number[]; months: number }
  692:   }>('/batch/renew', {
  693:     onRequest: [fastify.authenticateUser],
  694:     config: { rateLimit: { max: 5, timeWindow: '1 minute' } },
  695:     schema: {
  696:       body: {
  697:         type: 'object',
  698:         required: ['instanceIds', 'months'],
  699:         properties: {
  700:           instanceIds: {
  701:             type: 'array',
  702:             items: { type: 'integer' },
  703:             minItems: 1,
  704:             maxItems: 100
  705:           },
  706:           months: { type: 'integer', minimum: 1, maximum: 24 }
  707:         },
  708:         additionalProperties: false
  709:       }
  710:     }
  711:   }, async (request, reply) => {
  712:     const uniqueIds = Array.from(new Set(request.body.instanceIds)).filter(id => Number.isInteger(id))
  713:     if (uniqueIds.length === 0) {
  714:       return reply.code(400).send({ error: 'è¯·é€‰æ‹©è‡³å°‘ä¸€ä¸ªå®žä¾‹' })
  715:     }
  716: 
  717:     const userMeta = {
  718:       id: request.user.id,
  719:       username: request.user.username
  720:     }
  721: 
  722:     const results: BatchRenewResultItem[] = []
  723:     for (const instanceId of uniqueIds) {
  724:       const item = await executeRenewForUser(userMeta, instanceId, request.body.months)
  725:       results.push(item)
  726:     }
  727: 
  728:     const successCount = results.filter(item => item.success).length
  729:     const skippedCount = results.filter(item => item.skipped).length
  730:     const failedCount = results.length - successCount - skippedCount
  731: 
  732:     await createLog(
  733:       request.user.id,
  734:       'instance',
  735:       'instance.batch_renew',
  736:       `Batch renew processed ${results.length} instance(s): success=${successCount}, skipped=${skippedCount}, failed=${failedCount}`,
  737:       failedCount > 0 ? 'warning' : 'success'
  738:     )
  739: 
  740:     return {
  741:       message: successCount > 0 ? 'æ‰¹é‡ç»­è´¹å·²å¤„ç†' : 'æ²¡æœ‰å®žä¾‹å®Œæˆç»­è´¹',
  742:       successCount,
  743:       skippedCount,
  744:       failedCount,
  745:       results
  746:     }
  747:   })
  748: 
  749:   // ==================== å‡é™çº§é¢„è§ˆ ====================
  750:   // GET /api/instances/:id/change-plan/preview
  751:   fastify.get<{
  752:     Params: { id: string }
  753:     Querystring: { newPlanId: string }
  754:   }>('/:id/change-plan/preview', {
  755:     onRequest: [fastify.authenticateUser]
  756:   }, async (request, reply) => {
  757:     const { user } = request
  758:     const instanceId = parsePositiveRouteId(request.params.id)
  759:     const newPlanId = parsePositiveRouteId(request.query.newPlanId)
  760: 
  761:     if (!instanceId || !newPlanId) {
  762:       return reply.code(400).send(apiError(ErrorCode.INVALID_ID))
  763:     }
  764: 
  765:     const instance = await prisma.instance.findUnique({
  766:       where: { id: instanceId }
  767:     })
  768: 
  769:     if (!instance) {
  770:       return reply.code(404).send(apiError(ErrorCode.INSTANCE_NOT_FOUND))
  771:     }
  772: 
  773:     // åªæœ‰å®žä¾‹æ‰€æœ‰è€…å¯ä»¥é¢„è§ˆå‡é™çº§
  774:     if (instance.userId !== user.id) {
  775:       return reply.code(403).send(apiError(ErrorCode.FORBIDDEN))
  776:     }
  777: 
  778:     if (instance.status === 'deleted') {
  779:       return reply.code(400).send({ error: 'å®žä¾‹å·²åˆ é™¤ï¼Œæ— æ³•æ”¹é…', code: 'INSTANCE_DELETED' })
  780:     }
  781: 
  782:     // å…è´¹å®žä¾‹ä¸æ”¯æŒå‡é™çº§
  783:     if (!instance.packagePlanId) {
  784:       return reply.code(400).send({ error: 'å…è´¹å®žä¾‹ä¸æ”¯æŒå‡é™çº§', code: 'FREE_INSTANCE' })
  785:     }
  786: 
  787:     if (await checkExchangeBillingLock(instanceId, reply)) return
  788: 
  789:     // èŽ·å–æ–°æ–¹æ¡ˆ
  790:     const newPlan = await db.getPlanById(newPlanId)
  791:     if (!newPlan) {
  792:       return reply.code(404).send({ error: 'æ–¹æ¡ˆä¸å­˜åœ¨', code: 'PLAN_NOT_FOUND' })
  793:     }
  794: 
  795:     // éªŒè¯æ–¹æ¡ˆå±žäºŽåŒä¸€å¥—é¤
  796:     if (newPlan.packageId !== instance.packageId) {
  797:       return reply.code(400).send({ error: 'æ–°æ–¹æ¡ˆå¿…é¡»å±žäºŽåŒä¸€å¥—é¤', code: 'PLAN_NOT_IN_PACKAGE' })
  798:     }
  799: 
  800:     // ä¸èƒ½åˆ‡æ¢åˆ°ç›¸åŒæ–¹æ¡ˆ
  801:     if (instance.packagePlanId === newPlanId) {
  802:       return reply.code(400).send({ error: 'ä¸èƒ½åˆ‡æ¢åˆ°ç›¸åŒæ–¹æ¡ˆ', code: 'SAME_PLAN' })
  803:     }
  804: 
  805:     // æ–°æ–¹æ¡ˆå¿…é¡»æ˜¯ä¸Šæž¶çŠ¶æ€
  806:     if (!newPlan.isActive) {
  807:       return reply.code(400).send({ error: 'è¯¥æ–¹æ¡ˆå·²ä¸‹æž¶', code: 'PLAN_INACTIVE' })
  808:     }
  809:     if (newPlan.isSoldOut) {
  810:       return reply.code(400).send({ error: 'è¯¥æ–¹æ¡ˆå·²å”®ç½„', code: 'PLAN_SOLD_OUT' })
  811:     }
  812: 
  813:     // æ£€æŸ¥å®žä¾‹çŠ¶æ€ï¼ˆrunning/stopped æ‰èƒ½å‡é™çº§ï¼‰
  814:     const statusCanChange = ['running', 'stopped'].includes(instance.status)
  815: 
  816:     try {
  817:       const preview = await db.calculatePlanChange(instance, newPlan)
  818: 
  819:       // åªå…è®¸å‡çº§ï¼Œä¸å…è®¸é™çº§
  820:       if (!preview.isUpgrade) {
  821:         return reply.code(400).send({ error: 'ä¸æ”¯æŒé™çº§ï¼Œåªèƒ½å‡çº§åˆ°æ›´é«˜é…ç½®çš„æ–¹æ¡ˆ', code: 'DOWNGRADE_NOT_ALLOWED' })
  822:       }
  823: 
  824:       const capacity = await db.checkPlanUpgradeCapacity(instance, newPlan)
  825:       const capacityMessage = capacity.canUpgrade ? null : formatUpgradeCapacityMessage(capacity.reason)
  826: 
