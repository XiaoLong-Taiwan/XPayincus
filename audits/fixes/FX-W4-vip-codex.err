  181:   const reconciliationStartupTimer = setTimeout(() => void runReconciliation(), 10_000)
  182:   const reconciliationTimer = setInterval(() => void runReconciliation(), RESOURCE_POOL_RECONCILIATION_INTERVAL_MS)
  183:   reconciliationStartupTimer.unref()
  184:   reconciliationTimer.unref()
  185:   fastify.addHook('onClose', async () => {
  186:     clearTimeout(reconciliationStartupTimer)
