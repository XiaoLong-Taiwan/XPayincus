  348:       id: instance.id,
  349:       name: instance.name,
  350:       success: false,
  351:       skipped: true,
  352:       reason: 'å®žä¾‹å·²åˆ é™¤ï¼Œæ— æ³•ç»­è´¹'
  353:     }
  354:   }
  355: 
  356:   try {
  357:     const result = await db.performRenewal(user.id, instance, months)
  358: 
  359:     await sendNotification(user.id, 'instance_renewed', {
  360:       instanceName: instance.name,
  361:       renewAmount: result.amount,
  362:       renewMonths: months,
  363:       newExpiresAt: result.newExpiresAt.toISOString()
  364:     })
  365: 
  366:     if (result.hostingIncomeResult) {
  367:       sendHostManagedInstanceNotification(
  368:         instance.hostId,
  369:         'renew',
  370:         {
  371:           username: user.username,
  372:           instanceName: instance.name,
  373:           amount: result.amount
  374:         }
  375:       ).catch(err => {
  376:         console.warn('[æ‰¹é‡ç»­è´¹] å‘é€æ‰˜ç®¡æ”¶å…¥é€šçŸ¥å¤±è´¥:', err)
  377:       })
  378:     }
  379: 
  380:     try {
  381:       const userInfo = await db.findUserById(user.id)
  382:       if (userInfo?.email) {
  383:         await sendRenewSuccessEmail(userInfo.email, {
  384:           username: userInfo.username,
  385:           instanceName: instance.name,
  386:           amount: result.amount,
  387:           months,
  388:           newExpiresAt: result.newExpiresAt
  389:         })
  390:       }
  391:     } catch (emailErr) {
  392:       console.warn('[æ‰¹é‡ç»­è´¹] å‘é€ç»­è´¹æˆåŠŸé‚®ä»¶å¤±è´¥:', emailErr)
  393:     }
  394: 
  395:     await createLog(
  396:       user.id,
  397:       'instance',
  398:       'instance.renew',
  399:       `Renewed instance "${instance.name}" for ${months} month(s), amount: ${result.amount}`,
  400:       'success',
  401:       { instanceId: instance.id }
  402:     )
  403: 
  404:     return {
  405:       id: instance.id,
  406:       name: instance.name,
  407:       success: true,
  408:       amount: result.amount,
  409:       newExpiresAt: result.newExpiresAt.toISOString()
  410:     }
  411:   } catch (error) {
  412:     return {
  413:       id: preview.id,
  414:       name: preview.name,
  415:       success: false,
  416:       reason: 'ç»­è´¹å¤±è´¥'
  417:     }
  418:   }
  419: }
