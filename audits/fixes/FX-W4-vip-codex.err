 1010: export async function getInstanceBillingInfo(instanceId: number): Promise<{
 1011:   isPaid: boolean
 1012:   expiresAt: Date | null
 1013:   billingPrice: number | null
 1014:   billingCycle: number | null
 1015:   monthlyPrice: number | null
 1016:   autoRenew: boolean
 1017:   status: string
 1018:   suspendReason: string | null
 1019:   packagePlan: {
 1020:     id: number
 1021:     name: string
 1022:     isActive: boolean
 1023:   } | null
 1024:   renewPreview: Array<{ months: number; amount: number; discountedAmount: number; expiresAt: Date }> | null
 1025:   affDiscount: {
