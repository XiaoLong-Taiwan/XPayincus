   84: function parsePositiveConfigInteger(value: string, max = Number.MAX_SAFE_INTEGER): number | null {
   85:     const trimmed = value.trim()
   86:     if (!positiveIntegerConfigPattern.test(trimmed)) return null
   87:     const parsed = Number(trimmed)
   88:     return Number.isSafeInteger(parsed) && parsed <= max ? parsed : null
   89: }
   90: 
   91: function parseNonNegativeConfigInteger(value: string, max = Number.MAX_SAFE_INTEGER): number | null {
   92:     const trimmed = value.trim()
   93:     if (!nonNegativeIntegerConfigPattern.test(trimmed)) return null
   94:     const parsed = Number(trimmed)
   95:     return Number.isSafeInteger(parsed) && parsed <= max ? parsed : null
   96: }
   97: 
   98: function parseDecimalMoneyConfig(value: string, max: number): number | null {
   99:     const trimmed = value.trim()
  100:     if (!decimalMoneyPattern.test(trimmed)) return null
  101:     const parsed = Number(trimmed)
  102:     return Number.isFinite(parsed) && parsed >= 0 && parsed <= max ? parsed : null
  103: }
  104: 
  105: function parseRateConfig(value: string, max: number): number | null {
  106:     const trimmed = value.trim()
  107:     if (!rateConfigPattern.test(trimmed)) return null
  108:     const parsed = Number(trimmed)
  109:     return Number.isFinite(parsed) && parsed >= 0 && parsed <= max ? parsed : null
  110: }
  111: 
  112: function normalizeAdminIdCsv(value: string): string | null {
  113:     const trimmed = value.trim()
  114:     if (!trimmed) return ''
  115:     if (!adminIdCsvPattern.test(trimmed)) return null
  116:     const ids = Array.from(new Set(trimmed.split(',').map(item => Number(item.trim()))))
  117:     if (ids.some(id => !Number.isSafeInteger(id) || id <= 0)) return null
  118:     return ids.join(',')
  119: }
  120: 
  121: function normalizeTrustedHostsCsv(value: string): string | null {
  122:     const trimmed = value.trim()
  123:     if (!trimmed) return ''
  124:     const hosts = Array.from(new Set(
  125:         trimmed
  126:             .split(',')
  127:             .map(item => item.trim().toLowerCase())
  128:             .filter(Boolean)
  129:     ))
  130:     if (hosts.length > 50) return null
  131:     if (hosts.some(host => host.length > 253 || !trustedHostPattern.test(host))) return null
  132:     return hosts.join(',')
  133: }
  134: 
  135: async function normalizeOptionalSafeHttpsUrl(value: string, label: string, maxLength = 1000): Promise<string | null> {
  136:     const trimmed = value.trim()
  137:     if (!trimmed) return ''
  138:     if (trimmed.length > maxLength) return null
  139:     try {
  140:         const url = await assertSafeHttpUrl(trimmed, label)
  141:         if (url.protocol !== 'https:') return null
  142:         return url.toString().replace(/\/+$/, '')
  143:     } catch {
  144:         return null
  145:     }
  146: }
