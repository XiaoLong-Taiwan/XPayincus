 1027:     affCodeId: number
 1028:   } | null
 1029:   // æ‰˜ç®¡å®žä¾‹ç›¸å…³ä¿¡æ¯
 1030:   isHostedInstance: boolean
 1031:   daysUntilExpire: number | null
 1032:   hostingRenewRestriction: { monthsOnly: number; daysBeforeExpire: number } | null
 1033: } | null> {
 1034:   const instance = await prisma.instance.findUnique({
 1035:     where: { id: instanceId },
 1036:     include: {
 1037:       packagePlan: {
 1038:         select: { id: true, name: true, isActive: true }
 1039:       },
 1040:       host: {
 1041:         select: {
 1042:           userId: true,
 1043:           user: {
 1044:             select: {
 1045:               role: true
 1046:             }
 1047:           }
 1048:         }
 1049:       }
 1050:     }
 1051:   })
 1052: 
 1053:   if (!instance) return null
 1054: 
 1055:   const isPaid = instance.packagePlanId !== null
 1056: 
 1057:   // åˆ¤æ–­æ˜¯å¦ä¸ºæ‰˜ç®¡å®žä¾‹ï¼ˆèŠ‚ç‚¹æ‰€æœ‰è€…ä¸æ˜¯ç®¡ç†å‘˜ï¼‰
 1058:   const isHostedInstance = instance.host?.user.role === 'user'
 1059: 
 1060:   // è®¡ç®—å‰©ä½™å¤©æ•°
 1061:   let daysUntilExpire: number | null = null
 1062:   if (instance.expiresAt) {
 1063:     const now = new Date()
 1064:     daysUntilExpire = Math.ceil((instance.expiresAt.getTime() - now.getTime()) / (1000 * 60 * 60 * 24))
 1065:   }
 1066: 
 1067:   // æ‰˜ç®¡ç»­è´¹é™åˆ¶
 1068:   const hostingRenewRestriction = isHostedInstance ? { monthsOnly: 1, daysBeforeExpire: 7 } : null
 1069: 
 1070:   let monthlyPrice: number | null = null
 1071:   let renewPreview: Array<{ months: number; amount: number; discountedAmount: number; expiresAt: Date }> | null = null
 1072:   let affDiscount: { discountRate: number; affCodeId: number } | null = null
 1073: 
 1074:   if (isPaid && instance.billingPrice) {
 1075:     monthlyPrice = calculateMonthlyPrice({
 1076:       billingPrice: instance.billingPrice,
 1077:       billingCycle: instance.billingCycle
 1078:     })
 1079: 
 1080:     // èŽ·å– AFF ç»‘å®šä¿¡æ¯ï¼Œè®¡ç®—æŠ˜æ‰£
 1081:     const affBinding = await getInstanceAffBinding(instanceId)
 1082:     let discountRate = 0
 1083:     if (affBinding) {
 1084:       discountRate = Number(affBinding.affCode.discountRate)
 1085:       affDiscount = {
 1086:         discountRate,
 1087:         affCodeId: affBinding.affCode.id
 1088:       }
 1089:     }
 1090: 
 1091:     // è®¡ç®—ç»­è´¹é¢„è§ˆï¼ˆåŒ…å«æŠ˜æ‰£ä»·ï¼‰
 1092:     const originalPreview = previewRenewPrices({
 1093:       billingPrice: instance.billingPrice,
 1094:       billingCycle: instance.billingCycle,
 1095:       expiresAt: instance.expiresAt
 1096:     })
 1097: 
 1098:     // æ‰˜ç®¡å®žä¾‹åªè¿”å›ž1ä¸ªæœˆçš„ç»­è´¹é€‰é¡¹
 1099:     const filteredPreview = isHostedInstance
 1100:       ? originalPreview.filter(p => p.months === 1)
 1101:       : originalPreview
 1102: 
 1103:     renewPreview = filteredPreview.map(p => ({
 1104:       months: p.months,
 1105:       amount: p.amount,  // åŽŸä»·ï¼ˆå…ƒï¼‰
 1106:       discountedAmount: discountRate > 0
 1107:         ? Number((p.amount * (1 - discountRate)).toFixed(2))  // æŠ˜æ‰£ä»·ï¼ˆå…ƒï¼Œä¿ç•™ä¸¤ä½å°æ•°ï¼‰
 1108:         : p.amount,
 1109:       expiresAt: p.expiresAt
 1110:     }))
 1111:   }
 1112: 
 1113:   return {
 1114:     isPaid,
 1115:     expiresAt: instance.expiresAt,
