  877:   }>('/:id/change-plan', {
  878:     onRequest: [fastify.authenticateUser],
  879:     config: { rateLimit: { max: 5, timeWindow: '1 minute' } },
  880:     schema: {
  881:       body: {
  882:         type: 'object',
