   57: async function withInstanceBillingJobLock(
   58:   purpose: 'auto-renew' | 'expiry-suspend' | 'expiry-delete' | 'expiry-notify',
   59:   instanceId: number,
   60:   fn: () => Promise<void>
   61: ): Promise<void> {
   62:   const lockKey = `billing:${purpose}:instance:${instanceId}`
   63:   const lock = await acquireLock(lockKey, {
   64:     expireMs: INSTANCE_BILLING_JOB_LOCK_EXPIRE_MS,
   65:     waitTimeoutMs: INSTANCE_BILLING_JOB_LOCK_WAIT_MS,
   66:     retryIntervalMs: 50
   67:   })
   68: 
   69:   if (!lock.success || !lock.ownerId) {
   70:     console.log(`[Billing] Skip ${purpose} for instance ${instanceId}: lock not acquired`)
   71:     return
   72:   }
   73: 
   74:   try {
   75:     await fn()
   76:   } finally {
   77:     await releaseLock(lockKey, lock.ownerId)
   78:   }
   79: }
