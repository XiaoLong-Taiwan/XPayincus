  884:         properties: {
  885:           newPlanId: { type: 'integer' }
  886:         }
  887:       }
  888:     }
  889:   }, async (request, reply) => {
  890:     const { user } = request
  891:     const instanceId = parsePositiveRouteId(request.params.id)
  892:     const newPlanId = parsePositiveIntegerInput(request.body.newPlanId)
  893: 
  894:     if (!instanceId || !newPlanId) {
  895:       return reply.code(400).send(apiError(ErrorCode.INVALID_ID))
  896:     }
  897: 
  898:     const instance = await prisma.instance.findUnique({
  899:       where: { id: instanceId },
  900:       include: {
  901:         package: { select: { instanceType: true } }
  902:       }
  903:     })
  904: 
  905:     if (!instance) {
  906:       return reply.code(404).send(apiError(ErrorCode.INSTANCE_NOT_FOUND))
  907:     }
  908: 
  909:     // åªæœ‰å®žä¾‹æ‰€æœ‰è€…å¯ä»¥å‡é™çº§
  910:     if (instance.userId !== user.id) {
  911:       return reply.code(403).send(apiError(ErrorCode.FORBIDDEN))
  912:     }
  913: 
  914:     if (instance.status === 'deleted') {
  915:       return reply.code(400).send({ error: 'å®žä¾‹å·²åˆ é™¤ï¼Œæ— æ³•æ”¹é…', code: 'INSTANCE_DELETED' })
  916:     }
  917: 
  918:     // å…è´¹å®žä¾‹ä¸æ”¯æŒå‡é™çº§
  919:     if (!instance.packagePlanId) {
  920:       return reply.code(400).send({ error: 'å…è´¹å®žä¾‹ä¸æ”¯æŒå‡é™çº§', code: 'FREE_INSTANCE' })
  921:     }
  922: 
  923:     if (await checkExchangeBillingLock(instanceId, reply)) return
  924: 
  925:     // èŽ·å–æ–°æ–¹æ¡ˆ
  926:     const newPlan = await db.getPlanById(newPlanId)
  927:     if (!newPlan) {
  928:       return reply.code(404).send({ error: 'æ–¹æ¡ˆä¸å­˜åœ¨', code: 'PLAN_NOT_FOUND' })
  929:     }
  930: 
  931:     // éªŒè¯æ–¹æ¡ˆå±žäºŽåŒä¸€å¥—é¤
  932:     if (newPlan.packageId !== instance.packageId) {
  933:       return reply.code(400).send({ error: 'æ–°æ–¹æ¡ˆå¿…é¡»å±žäºŽåŒä¸€å¥—é¤', code: 'PLAN_NOT_IN_PACKAGE' })
  934:     }
  935: 
  936:     // ä¸èƒ½åˆ‡æ¢åˆ°ç›¸åŒæ–¹æ¡ˆ
  937:     if (instance.packagePlanId === newPlanId) {
  938:       return reply.code(400).send({ error: 'ä¸èƒ½åˆ‡æ¢åˆ°ç›¸åŒæ–¹æ¡ˆ', code: 'SAME_PLAN' })
  939:     }
