  190:   // ==================== èŽ·å–ç”¨æˆ·èµ„æºæ±  ====================
  191:   fastify.get('/', {
  192:     onRequest: [fastify.authenticateUser]
  193:   }, async (request: FastifyRequest, _reply: FastifyReply) => {
  194:     const { user } = request
  195:     const pool = await db.getUserResourcePool(user.id)
  196:     return pool
  197:   })
  198: 
  199:   // ==================== åº”ç”¨èµ„æºåˆ°å®žä¾‹ ====================
  200:   fastify.post<{
  201:     Body: {
  202:       instanceId: number
  203:       resourceType: string
  204:       amount: number
  205:     }
  206:   }>('/apply', {
  207:     onRequest: [fastify.authenticateUser],
  208:     schema: {
  209:       body: {
  210:         type: 'object',
  211:         required: ['instanceId', 'resourceType', 'amount'],
  212:         properties: {
  213:           instanceId: { type: 'integer', minimum: 1 },
  214:           resourceType: { type: 'string', enum: ['c', 'r', 'd', 't'] },
  215:           amount: { type: 'integer', minimum: 1, maximum: db.MAX_RESOURCE_POOL_APPLY_AMOUNT }
  216:         }
  217:       }
  218:     }
  219:   }, async (request: FastifyRequest<{ Body: { instanceId: number; resourceType: string; amount: number } }>, reply: FastifyReply) => {
  220:     const { user } = request
  221:     const { instanceId, resourceType, amount } = request.body
  222: 
  223:     try {
  224:       const response = await withResourcePoolApplyLocks(user.id, instanceId, resourceType, async () => {
  225:         const instance = await db.getInstanceById(instanceId)
  226:         if (!instance) {
  227:           throw new Error('INSTANCE_NOT_FOUND')
  228:         }
  229: 
  230:         if (instance.user_id !== user.id) {
  231:           throw new Error('FORBIDDEN')
  232:         }
  233: 
  234:         if (!['running', 'stopped'].includes(instance.status)) {
  235:           throw new Error('INSTANCE_STATUS_INVALID')
  236:         }
  237: 
  238:         const host = await db.getHostById(instance.host_id)
  239:         if (!host) {
  240:           throw new Error('HOST_NOT_FOUND')
  241:         }
  242: 
  243:         if (!host.enable_resource_pool) {
  244:           throw new Error('RESOURCE_POOL_DISABLED')
  245:         }
  246: 
  247:         if (resourceType === 'c' && host.instance_type === 'vm' && amount % 100 !== 0) {
  248:           throw new Error('RESOURCE_POOL_KVM_CPU_MULTIPLE')
  249:         }
  250: 
  251:         if (resourceType === 'r' && host.instance_type === 'vm' && amount % 128 !== 0) {
  252:           throw new Error('RESOURCE_POOL_KVM_MEMORY_MULTIPLE')
  253:         }
  254: 
  255:         if (resourceType === 'd' && host.instance_type === 'vm' && amount % 1024 !== 0) {
  256:           throw new Error('RESOURCE_POOL_KVM_DISK_MULTIPLE')
  257:         }
  258: 
  259:         if ((resourceType === 'r' || resourceType === 'd') && host.instance_type === 'vm' && instance.status !== 'stopped') {
  260:           throw new Error('RESOURCE_POOL_VM_MUST_STOP')
  261:         }
  262: 
  263:         let resourcesToPatch: { cpu?: number; memory?: number; disk?: number } | null = null
  264:         let applyLogId: number | null = null
  265: 
  266:         if (resourceType === 'c') {
  267:           const newCpu = instance.cpu + amount
  268:           applyLogId = await db.applyResourcePoolToInstance({
  269:             userId: user.id,
  270:             instanceId,
  271:             hostId: instance.host_id,
  272:             resourceType: resourceType as RedeemCodeType,
  273:             amount,
  274:             remark: `åº”ç”¨åˆ°å®žä¾‹ ${instance.name}`,
  275:             instanceResources: { cpu: newCpu },
  276:             hostResourceDelta: { cpuUsed: amount }
  277:           })
  278:           if (applyLogId === null) {
  279:             throw new Error('RESOURCE_POOL_INSUFFICIENT')
  280:           }
  281:           resourcesToPatch = { cpu: newCpu }
  282:         } else if (resourceType === 'r') {
  283:           const newMemory = instance.memory + amount
  284:           applyLogId = await db.applyResourcePoolToInstance({
  285:             userId: user.id,
  286:             instanceId,
  287:             hostId: instance.host_id,
  288:             resourceType: resourceType as RedeemCodeType,
  289:             amount,
  290:             remark: `åº”ç”¨åˆ°å®žä¾‹ ${instance.name}`,
  291:             instanceResources: { memory: newMemory },
  292:             hostResourceDelta: { memoryUsed: amount }
  293:           })
  294:           if (applyLogId === null) {
  295:             throw new Error('RESOURCE_POOL_INSUFFICIENT')
  296:           }
  297:           resourcesToPatch = { memory: newMemory }
  298:         } else if (resourceType === 'd') {
  299:           const newDisk = instance.disk + amount
  300:           applyLogId = await db.applyResourcePoolToInstance({
  301:             userId: user.id,
  302:             instanceId,
  303:             hostId: instance.host_id,
  304:             resourceType: resourceType as RedeemCodeType,
  305:             amount,
  306:             remark: `åº”ç”¨åˆ°å®žä¾‹ ${instance.name}`,
  307:             instanceResources: { disk: newDisk },
  308:             hostResourceDelta: { diskUsed: amount }
  309:           })
  310:           if (applyLogId === null) {
  311:             throw new Error('RESOURCE_POOL_INSUFFICIENT')
  312:           }
  313:           resourcesToPatch = { disk: newDisk }
  314:         } else if (resourceType === 't') {
  315:           const trafficBytes = BigInt(amount) * BigInt(1024 * 1024 * 1024)
  316:           applyLogId = await db.applyResourcePoolToInstance({
  317:             userId: user.id,
  318:             instanceId,
  319:             hostId: instance.host_id,
  320:             resourceType: resourceType as RedeemCodeType,
  321:             amount,
  322:             remark: `åº”ç”¨åˆ°å®žä¾‹ ${instance.name}`,
  323:             monthlyTrafficDelta: trafficBytes
  324:           })
  325:           if (applyLogId === null) {
  326:             throw new Error('RESOURCE_POOL_INSUFFICIENT')
  327:           }
  328:         }
  329: 
  330:         let reconciliationPending = false
  331:         if (resourcesToPatch) {
  332:           try {
  333:             const client = await getIncusClient(host)
  334:             await patchInstanceResources(client, instance.incus_id, resourcesToPatch)
  335:             await db.markResourcePoolAppliesReconciled([applyLogId!])
  153: export async function applyResourcePoolToInstance(data: {
  154:   userId: number
  155:   instanceId: number
  156:   hostId: number
  157:   resourceType: RedeemCodeType
  158:   amount: number
  159:   remark?: string
  160:   instanceResources?: {
  161:     cpu?: number
  162:     memory?: number
  163:     disk?: number
  164:   }
  165:   hostResourceDelta?: {
  166:     cpuUsed?: number
  167:     memoryUsed?: number
  168:     diskUsed?: number
  169:   }
  170:   monthlyTrafficDelta?: bigint
  171: }): Promise<number | null> {
  172:   if (!Number.isSafeInteger(data.amount) || data.amount <= 0 || data.amount > MAX_RESOURCE_POOL_APPLY_AMOUNT) {
  173:     throw new Error('Invalid resource pool apply amount')
  174:   }
  175: 
  176:   const field = RESOURCE_FIELD_MAP[data.resourceType]
  177:   if (!field) {
  178:     throw new Error(`Invalid resource type: ${data.resourceType}`)
  179:   }
  180: 
  181:   return prisma.$transaction(async (tx) => {
  182:     await advisoryTransactionLock(tx, USER_RESOURCE_POOL_LOCK_NAMESPACE, data.userId)
  183:     await advisoryTransactionLock(tx, INSTANCE_OPERATION_LOCK_NAMESPACE, data.instanceId)
  184: 
  185:     let decrementResult = 0
  186:     if (field === 'cpu') {
  187:       decrementResult = await tx.$executeRaw`
  188:         UPDATE "user_resource_pools"
  189:         SET "cpu" = "cpu" - ${data.amount}
  190:         WHERE "user_id" = ${data.userId}
  191:           AND "cpu" >= ${data.amount}
  192:       `
  193:     } else if (field === 'memory') {
  194:       decrementResult = await tx.$executeRaw`
  195:         UPDATE "user_resource_pools"
  196:         SET "memory" = "memory" - ${data.amount}
  197:         WHERE "user_id" = ${data.userId}
  198:           AND "memory" >= ${data.amount}
  199:       `
  200:     } else if (field === 'disk') {
  201:       decrementResult = await tx.$executeRaw`
  202:         UPDATE "user_resource_pools"
  203:         SET "disk" = "disk" - ${data.amount}
  204:         WHERE "user_id" = ${data.userId}
  205:           AND "disk" >= ${data.amount}
  206:       `
  207:     } else {
  208:       const amount = BigInt(data.amount)
  209:       decrementResult = await tx.$executeRaw`
  210:         UPDATE "user_resource_pools"
  211:         SET "traffic" = "traffic" - ${amount}
  212:         WHERE "user_id" = ${data.userId}
  213:           AND "traffic" >= ${amount}
  214:       `
  215:     }
  216: 
  217:     if (decrementResult === 0) {
  218:       return null
  219:     }
  220: 
  221:     const applyLog = await tx.resourcePoolLog.create({
  222:       data: {
  223:         userId: data.userId,
  224:         action: 'apply',
  225:         resourceType: data.resourceType,
  226:         amount: -data.amount,
  227:         instanceId: data.instanceId,
  228:         remark: data.resourceType === 't'
  229:           ? data.remark
  230:           : `${RESOURCE_POOL_INCUS_PENDING_PREFIX}${data.remark ?? ''}`
  231:       }
  232:     })
  233: 
  234:     if (data.hostResourceDelta) {
  235:       const cpuDelta = data.hostResourceDelta.cpuUsed ?? 0
  236:       const memoryDelta = data.hostResourceDelta.memoryUsed ?? 0
  237:       const diskDelta = data.hostResourceDelta.diskUsed ?? 0
  238:       if (cpuDelta < 0 || memoryDelta < 0 || diskDelta < 0) {
  239:         throw new Error('Resource amounts must be non-negative')
  240:       }
  241: 
  242:       const host = await tx.host.findUnique({
  243:         where: { id: data.hostId },
  244:         select: {
  245:           cpuAllowanceMax: true,
  246:           memoryMax: true,
  247:           storageSize: true
  248:         }
  249:       })
  250:       if (!host) {
  251:         throw new Error('HOST_NOT_FOUND')
  252:       }
  253: 
  254:       const cpuLimit = host.cpuAllowanceMax || 0
  255:       const memoryLimit = host.memoryMax || 0
  256:       const diskLimit = host.storageSize > 0 ? host.storageSize * 1024 : 0
  257:       if (
  258:         (cpuLimit > 0 && cpuDelta > cpuLimit) ||
  259:         (memoryLimit > 0 && memoryDelta > memoryLimit) ||
  260:         (diskLimit > 0 && diskDelta > diskLimit)
  261:       ) {
  262:         throw new Error('HOST_RESOURCES_INSUFFICIENT')
  263:       }
  264: 
  265:       const applyWhere: Prisma.HostWhereInput = { id: data.hostId }
  266:       if (cpuLimit > 0) {
  267:         applyWhere.cpuUsed = { lte: cpuLimit - cpuDelta }
  268:       }
  269:       if (memoryLimit > 0) {
  270:         applyWhere.memoryUsed = { lte: memoryLimit - memoryDelta }
  271:       }
  272:       if (diskLimit > 0) {
  273:         applyWhere.diskUsed = { lte: diskLimit - diskDelta }
  274:       }
  275: 
  276:       const hostUpdate = await tx.host.updateMany({
  277:         where: applyWhere,
  278:         data: {
  279:           cpuUsed: { increment: cpuDelta },
  280:           memoryUsed: { increment: memoryDelta },
  281:           diskUsed: { increment: diskDelta }
  282:         }
  283:       })
  284:       if (hostUpdate.count === 0) {
  285:         throw new Error('HOST_RESOURCES_INSUFFICIENT')
  286:       }
  287:     }
  288: 
  289:     if (data.instanceResources) {
  290:       await tx.instance.update({
  291:         where: { id: data.instanceId },
  292:         data: data.instanceResources
  293:       })
  294:     }
  295: 
  296:     if (data.monthlyTrafficDelta !== undefined) {
  297:       await tx.$executeRaw`
  298:         UPDATE "instances"
  299:         SET "monthly_traffic_limit" = COALESCE("monthly_traffic_limit", 0) + ${data.monthlyTrafficDelta}
  300:         WHERE "id" = ${data.instanceId}
  301:       `
  302:     }
  303: 
  304:     return applyLog.id
  305:   })
  306: }
  680:     totalConsume: consumeMap.get(userId) || 0,
  681:     totalRecharge: toNumber(rechargeResult[0]?.value)
  682:   }
  683: }
