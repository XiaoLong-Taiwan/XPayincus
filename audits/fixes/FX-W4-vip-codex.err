  server\prisma\schema.prisma:3205:  updatedAt    DateTime       @updatedAt @map("updated_at") // 状态变更时自动更新，用于超时检测
  server\prisma\schema.prisma:3206:  acceptedAt   DateTime?      @map("accepted_at")
  server\prisma\schema.prisma:3207:  rejectedAt   DateTime?      @map("rejected_at")
  server\prisma\schema.prisma:3208:  cancelledAt  DateTime?      @map("cancelled_at")
