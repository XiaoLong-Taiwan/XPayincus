  421: export default async function instanceBillingRoutes(fastify: FastifyInstance) {
  422:   // ==================== èŽ·å–å®žä¾‹è®¡è´¹ä¿¡æ¯ ====================
  423:   // GET /api/instances/:id/billing
  424:   fastify.get<{ Params: { id: string } }>('/:id/billing', {
  425:     onRequest: [fastify.authenticate]
  426:   }, async (request: FastifyRequest<{ Params: { id: string } }>, reply: FastifyReply) => {
  427:     const { user } = request
  428:     const instanceId = parsePositiveRouteId(request.params.id)
  429: 
  430:     if (!instanceId) {
  431:       return reply.code(400).send(apiError(ErrorCode.INVALID_ID))
  432:     }
  433: 
  434:     const instance = await db.getInstanceById(instanceId)
  435:     if (!instance) {
  436:       return reply.code(404).send(apiError(ErrorCode.INSTANCE_NOT_FOUND))
  437:     }
  438: 
  439:     // æƒé™æ£€æŸ¥ï¼šå®žä¾‹æ‰€æœ‰è€…æˆ–èŠ‚ç‚¹æ‰€æœ‰è€…
  440:     const isOwner = instance.user_id === user.id
  441:     const host = await db.getHostById(instance.host_id)
  442:     const isHostOwner = host && host.user_id === user.id
  443: 
  444:     if (!isOwner && !isHostOwner) {
  445:       return reply.code(403).send(apiError(ErrorCode.FORBIDDEN))
  446:     }
  447: 
  448:     const billingInfo = await db.getInstanceBillingInfo(instanceId)
  449:     if (!billingInfo) {
  450:       return reply.code(404).send(apiError(ErrorCode.INSTANCE_NOT_FOUND))
  451:     }
  452: 
  453:     // è½¬æ¢ä¸ºå‰ç«¯æœŸæœ›çš„æ ¼å¼
  454:     return {
  455:       billing: {
  456:         instanceId,
  457:         instanceName: instance.name,
  458:         planId: billingInfo.packagePlan?.id || null,
  459:         planName: billingInfo.packagePlan?.name || null,
  460:         price: billingInfo.billingPrice,  // å…ƒï¼ˆæ•°æ®åº“å­˜å‚¨çš„æ˜¯å…ƒï¼‰
  461:         billingCycle: billingInfo.billingCycle,
  462:         expiresAt: billingInfo.expiresAt?.toISOString() || null,
  463:         autoRenew: billingInfo.autoRenew,
  464:         // å°† amount è½¬æ¢ä¸º priceï¼ˆå‰ç«¯æœŸæœ›çš„å­—æ®µåï¼‰ï¼ŒåŒ…å«æŠ˜æ‰£ä»·
  465:         renewPreview: billingInfo.renewPreview?.map(p => ({
  466:           months: p.months,
  467:           price: p.amount,  // åŽŸä»·ï¼ˆå…ƒï¼‰
  468:           discountedPrice: p.discountedAmount,  // æŠ˜æ‰£ä»·ï¼ˆå…ƒï¼‰
  469:           expiresAt: p.expiresAt.toISOString()
  470:         })) || null,
  471:         // AFF æŠ˜æ‰£ä¿¡æ¯
  472:         affDiscount: billingInfo.affDiscount ? {
  473:           discountRate: billingInfo.affDiscount.discountRate,
  474:           discountPercent: Math.round(billingInfo.affDiscount.discountRate * 100)  // ç™¾åˆ†æ¯”ï¼Œå¦‚ 5 è¡¨ç¤º 5%
  475:         } : null,
  476:         // æ‰˜ç®¡å®žä¾‹ç›¸å…³ä¿¡æ¯
  477:         isHostedInstance: billingInfo.isHostedInstance,
  478:         daysUntilExpire: billingInfo.daysUntilExpire,
  479:         hostingRenewRestriction: billingInfo.hostingRenewRestriction
  480:       }
  481:     }
  482:   })
  483: 
  484:   // ==================== ç»‘å®š AFF ä¼˜æƒ ç ï¼ˆä»…å½±å“åŽç»­ç»­è´¹ï¼‰ ====================
  485:   // POST /api/instances/:id/apply-aff
  486:   fastify.post<{
  487:     Params: { id: string }
  488:     Body: { affCode: string }
  489:   }>('/:id/apply-aff', {
  490:     onRequest: [fastify.authenticateUser],
  491:     config: { rateLimit: { max: 10, timeWindow: '1 minute' } },
  492:     schema: {
  493:       body: {
  494:         type: 'object',
  495:         required: ['affCode'],
  496:         properties: {
  497:           affCode: { type: 'string', minLength: 3, maxLength: 64 }
