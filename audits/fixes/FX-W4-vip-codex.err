   75: function isHttpImageUrl(value: string): boolean {
   76:     try {
   77:         const imageUrl = new URL(value)
   78:         return ['http:', 'https:'].includes(imageUrl.protocol)
   79:     } catch {
   80:         return false
   81:     }
