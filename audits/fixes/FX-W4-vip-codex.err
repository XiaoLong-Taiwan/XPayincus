import assert from 'node:assert/strict'
import { arbitrateVipPrice, calculateVipExtraTraffic, calculateVipResourcePoolCost, normalizeVipBenefitsConfig, DEFAULT_VIP_BENEFITS_CONFIG } from './src/services/vip-benefits.ts'
assert.deepEqual(arbitrateVipPrice({ basePrice: 100, affDiscountRate: 0.02, vipDiscountPercent: 5 }), { finalPrice: 95, discountAmount: 5, source: 'vip' })
assert.deepEqual(arbitrateVipPrice({ basePrice: 100, affDiscountRate: 0.08, vipDiscountPercent: 5 }), { finalPrice: 92, discountAmount: 8, source: 'aff' })
assert.deepEqual(arbitrateVipPrice({ basePrice: 100, affDiscountRate: 0.5, vipDiscountPercent: 50, flashSalePrice: 70 }), { finalPrice: 70, discountAmount: 30, source: 'flash_sale' })
assert.equal(calculateVipExtraTraffic(1000n, 10), 100n)
assert.equal(calculateVipResourcePoolCost(110, 10), 100)
assert.deepEqual(normalizeVipBenefitsConfig(DEFAULT_VIP_BENEFITS_CONFIG), DEFAULT_VIP_BENEFITS_CONFIG)
console.log('VIP continuous benefit behavior smoke checks passed')
