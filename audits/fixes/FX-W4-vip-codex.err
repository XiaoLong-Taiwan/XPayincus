  137: /**
  138:  * æ ¼å¼åŒ–å­—èŠ‚æ•°ä¸ºäººç±»å¯è¯»æ ¼å¼
  139:  */
  140: export function formatBytes(bytes: bigint): string {
  141:     const units = ['B', 'KB', 'MB', 'GB', 'TB']
  142:     let value = Number(bytes)
  143:     let unitIndex = 0
  144: 
  145:     while (value >= 1024 && unitIndex < units.length - 1) {
  146:         value /= 1024
  147:         unitIndex++
  148:     }
  149: 
  150:     return `${value.toFixed(2)} ${units[unitIndex]}`
  151: }
  152: 
  153: /**
  154:  * è§£æžå­—èŠ‚å­—ç¬¦ä¸²ä¸º BigInt
  155:  * æ”¯æŒæ ¼å¼: "100GB", "1.5TB", "500MB" ç­‰
  156:  */
  157: export function parseBytes(str: string): bigint {
  158:     const match = str.match(/^([\d.]+)\s*(B|KB|MB|GB|TB)$/i)
  159:     if (!match) {
  160:         throw new Error(`Invalid byte string: ${str}`)
  161:     }
  162: 
  163:     const value = parseFloat(match[1])
  164:     const unit = match[2].toUpperCase()
  165: 
  166:     const multipliers: Record<string, bigint> = {
  167:         'B': 1n,
  168:         'KB': 1024n,
  169:         'MB': 1024n * 1024n,
  170:         'GB': 1024n * 1024n * 1024n,
  171:         'TB': 1024n * 1024n * 1024n * 1024n
  172:     }
  173: 
  174:     return BigInt(Math.floor(value * Number(multipliers[unit])))
  175: }
  176: 
  177: /**
  178:  * è®¡ç®—ç™¾åˆ†æ¯”
  179:  * æ³¨æ„: å…ˆè½¬æ¢ä¸º Number å†è®¡ç®—,é¿å… BigInt æ•´æ•°é™¤æ³•ç²¾åº¦ä¸¢å¤±
  180:  * ä¾‹å¦‚: 160MB / 257GB ç”¨ BigInt æ•´æ•°é™¤æ³•ä¼šå¾—åˆ° 0,è€Œéž 0.061%
  181:  */
  182: export function calculatePercentage(used: bigint, limit: bigint | null): number {
  183:     if (limit === null || limit === 0n) return 0
  184:     // å…ˆè½¬æ¢ä¸ºæµ®ç‚¹æ•°å†è®¡ç®—ç™¾åˆ†æ¯”,é¿å…æ•´æ•°é™¤æ³•å¯¼è‡´çš„ç²¾åº¦ä¸¢å¤±
  185:     const percentage = (Number(used) / Number(limit)) * 100
  186:     return Math.min(100, percentage)
  187: }
  188: 
  189: /**
  190:  * è®¡ç®—æµé‡ç»Ÿè®¡å‘¨æœŸ
  191:  * æ ¹æ®èŠ‚ç‚¹çš„é‡ç½®æ—¥è®¡ç®—å½“å‰å‘¨æœŸçš„èµ·æ­¢æ—¥æœŸ
  192:  * 
  193:  * @param resetDay é‡ç½®æ—¥ï¼ˆ1-28ï¼‰
  194:  * @param referenceDate å‚è€ƒæ—¥æœŸï¼ˆé»˜è®¤å½“å‰æ—¶é—´ï¼‰
  195:  * @returns å‘¨æœŸèµ·æ­¢æ—¥æœŸ
  196:  */
  197: export function getTrafficPeriod(resetDay: number, referenceDate: Date = new Date()): {
  198:     periodStart: Date
  199:     periodEnd: Date
  200: } {
  201:     // é™åˆ¶ resetDay åœ¨ 1-28 èŒƒå›´å†…
  202:     const day = Math.max(1, Math.min(28, resetDay))
  203:     
  204:     const year = referenceDate.getFullYear()
  205:     const month = referenceDate.getMonth()
  206:     const currentDay = referenceDate.getDate()
  207:     
  208:     let periodStart: Date
  209:     let periodEnd: Date
  210:     
  211:     if (currentDay >= day) {
  212:         // å½“å‰æ—¥æœŸ >= é‡ç½®æ—¥ï¼šå‘¨æœŸä¸ºæœ¬æœˆresetDay ~ ä¸‹æœˆresetDay
  213:         periodStart = new Date(year, month, day, 0, 0, 0, 0)
  214:         periodEnd = new Date(year, month + 1, day, 0, 0, 0, 0)
  215:     } else {
  216:         // å½“å‰æ—¥æœŸ < é‡ç½®æ—¥ï¼šå‘¨æœŸä¸ºä¸ŠæœˆresetDay ~ æœ¬æœˆresetDay
  217:         periodStart = new Date(year, month - 1, day, 0, 0, 0, 0)
  218:         periodEnd = new Date(year, month, day, 0, 0, 0, 0)
  219:     }
  220:     
  221:     return { periodStart, periodEnd }
  222: }
  223: 
  224: /**
  225:  * æ£€æŸ¥ä»Šå¤©æ˜¯å¦æ˜¯æŒ‡å®šçš„é‡ç½®æ—¥
  226:  */
  227: export function isTodayResetDay(resetDay: number): boolean {
  228:     const today = new Date().getDate()
  229:     return today === resetDay
  230: }
  231: 
  232: /**
  233:  * å°† Date å¯¹è±¡æ ¼å¼åŒ–ä¸ºæœ¬åœ°æ—¥æœŸå­—ç¬¦ä¸² (YYYY-MM-DD)
  234:  * é¿å… toISOString() å¯¼è‡´çš„ UTC æ—¶åŒºåç§»é—®é¢˜
  235:  */
  236: export function formatLocalDate(date: Date): string {
  237:     const year = date.getFullYear()
  238:     const month = String(date.getMonth() + 1).padStart(2, '0')
  239:     const day = String(date.getDate()).padStart(2, '0')
  240:     return `${year}-${month}-${day}`
  241: }
