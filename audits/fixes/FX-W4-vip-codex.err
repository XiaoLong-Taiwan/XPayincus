  100: /**
  101:  * æ£€æŸ¥æ˜¯å¦è¾¾åˆ°é¢„è­¦é˜ˆå€¼ (80%)
  102:  */
  103: export function isWarningThreshold(used: bigint, limit: bigint | null): boolean {
  104:     if (limit === null) return false
  105:     return used >= (limit * 80n) / 100n
  106: }
  107: 
  108: /**
  109:  * æ£€æŸ¥é¢„è­¦æ˜¯å¦åœ¨å½“æœˆå·²å‘é€
  110:  */
  111: export function isWarningSentThisMonth(sentAt: Date | null): boolean {
  112:     if (!sentAt) return false
  113:     const now = new Date()
  114:     return sentAt.getMonth() === now.getMonth() && sentAt.getFullYear() === now.getFullYear()
  115: }
  116: 
  117: /**
  118:  * è®¡ç®—ç”¨æˆ·å½“å‰åº”æœ‰çš„æµé‡çŠ¶æ€
  119:  */
  120: export function calculateUserTrafficStatus(used: bigint, limit: bigint | null): 'NORMAL' | 'WARNING' | 'LIMITED' {
  121:     if (isOverLimit(used, limit)) {
  122:         return 'LIMITED'
  123:     }
  124:     if (isWarningThreshold(used, limit)) {
  125:         return 'WARNING'
  126:     }
  127:     return 'NORMAL'
  128: }
