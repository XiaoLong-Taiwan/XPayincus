  339: // æ³¨å†Œè®¾ç½®ä¿å­˜
  340: const registrationKeys = ['registration_enabled', 'require_invite_code']
  341: async function saveRegistration() {
  342:   await saveConfigGroup(registrationKeys, savingRegistration)
  343: }
  344: const hasRegistrationChanges = computed(() => {
  345:   return registrationKeys.some(key => {
  346:     const config = configs.value.find(c => c.key === key)
  347:     if (!config) return false
  348:     return String((form.value as any)[key]) !== config.value
  349:   })
  350: })
  351: 
  352: function normalizeInviteCostOptions() {
  353:   const options = Array.isArray(form.value.invite_generation_costs)
  354:     ? form.value.invite_generation_costs
  355:     : []
  356:   const optionMap = new Map(options.map((option: any) => [option.resource, option]))
  357:   for (const resource of ['balance', 'points']) {
  358:     if (!optionMap.has(resource)) {
  359:       optionMap.set(resource, { resource, amount: 0, enabled: false })
  360:     }
  361:   }
  362:   form.value.invite_generation_costs = Array.from(optionMap.values()).map((option: any) => ({
  363:     resource: option.resource,
  364:     amount: option.resource === 'points'
  365:       ? Math.max(0, Math.floor(Number(option.amount) || 0))
