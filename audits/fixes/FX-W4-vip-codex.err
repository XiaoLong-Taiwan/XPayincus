  server\prisma\schema.prisma:3198:  toUserId     Int            @map("to_user_id")
  server\prisma\schema.prisma:3199:  status       TransferStatus @default(pending)
  server\prisma\schema.prisma:3200:  snapshot     Json // 转移时的实例快照信息
  server\prisma\schema.prisma:3201:  remark       String? // 转移备注
  server\prisma\schema.prisma:3202:  rejectReason String?        @map("reject_reason")
  server\prisma\schema.prisma:3203:  fee          Decimal?       @db.Decimal(10, 2) // 转移手续费（元），拒绝时退还
