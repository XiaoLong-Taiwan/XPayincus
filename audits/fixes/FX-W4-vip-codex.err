+function defaultVipBenefitsConfig(): VipBenefitsConfig {
+  return {
+    levels: Object.fromEntries(Array.from({ length: 5 }, (_, index) => {
+      const level = index + 1
+      return [String(level), {
+        orderDiscountPercent: level,
+        extraTrafficPercent: level * 2,
+        resourcePoolBonusPercent: level * 2
+      }]
+    }))
+  }
+}
