  130: /**
  131:  * è®¡ç®—å®žä¾‹å½“å‰åº”æœ‰çš„æµé‡çŠ¶æ€
  132:  */
  133: export function calculateInstanceTrafficStatus(used: bigint, limit: bigint | null): 'NORMAL' | 'LIMITED' {
  134:     return isOverLimit(used, limit) ? 'LIMITED' : 'NORMAL'
