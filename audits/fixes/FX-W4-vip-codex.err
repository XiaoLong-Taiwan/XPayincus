    6: import type { Prisma } from '@prisma/client'
    7: 
    8: export interface TrafficSnapshotSample {
    9:     rxRaw: bigint
   10:     txRaw: bigint
   11:     sampledAt: Date
   12:     source: 'agent-report' | 'active-collector'
   13:     rxPacketsRaw?: bigint
   14:     txPacketsRaw?: bigint
   15:     cpuUsageRaw?: bigint | null
   16: }
   17: 
   18: /**
   19:  * åŽŸå­æŽ¨è¿›ä¸¤æ¡é‡‡é›†é€šé“å…±ç”¨çš„æµé‡å¿«ç…§ã€‚
   20:  * updatedAt ä½œä¸ºå¿«ç…§é‡‡æ ·æ—¶é—´ï¼›è¿Ÿåˆ°æ ·æœ¬ä¸èƒ½å›žé€€åŸºçº¿ï¼Œä¹Ÿä¸èƒ½å‚ä¸Žå¢žé‡è®¡é‡ã€‚
   21:  */
   22: export async function advanceTrafficSnapshot(
   23:     tx: Prisma.TransactionClient,
   24:     instanceId: number,
   25:     sample: TrafficSnapshotSample
   26: ) {
   27:     const previous = await tx.trafficSnapshot.findUnique({
   28:         where: { instanceId }
   29:     })
   30: 
   31:     const data = {
   32:         rxRaw: sample.rxRaw,
   33:         txRaw: sample.txRaw,
   34:         updatedAt: sample.sampledAt,
   35:         ...(sample.rxPacketsRaw !== undefined ? { rxPacketsRaw: sample.rxPacketsRaw } : {}),
   36:         ...(sample.txPacketsRaw !== undefined ? { txPacketsRaw: sample.txPacketsRaw } : {}),
   37:         ...(sample.cpuUsageRaw !== undefined ? { cpuUsageRaw: sample.cpuUsageRaw } : {})
   38:     }
   39: 
   40:     if (!previous) {
   41:         await tx.trafficSnapshot.create({
   42:             data: {
   43:                 instanceId,
   44:                 ...data
   45:             }
   46:         })
   47:         return { accepted: true, previous: null }
   48:     }
   49: 
   50:     const updateResult = await tx.trafficSnapshot.updateMany({
   51:         where: {
   52:             instanceId,
   53:             updatedAt: { lte: sample.sampledAt }
   54:         },
   55:         data
   56:     })
   57: 
   58:     if (updateResult.count === 0) {
   59:         console.debug('[Traffic] Dropped stale traffic sample', {
   60:             instanceId,
   61:             source: sample.source,
   62:             sampledAt: sample.sampledAt.toISOString(),
   63:             snapshotSampledAt: previous.updatedAt.toISOString()
   64:         })
   65:         return { accepted: false, previous }
   66:     }
   67: 
   68:     return { accepted: true, previous }
   69: }
   70: 
   71: /**
   72:  * è®¡ç®—æµé‡å¢žé‡
   73:  * è®¡æ•°å™¨å½’é›¶æˆ–ç»Ÿè®¡å£å¾„å˜åŒ–æ—¶åªé‡å»ºåŸºçº¿ï¼Œä¸è¿½è¡¥å½“å‰åŽŸå§‹å€¼ã€‚
   74:  * è¿™æ ·ä¼šå°‘è®¡ä¸€æ¬¡é‡‡æ ·çª—å£ï¼Œä½†èƒ½é¿å…æŠŠåŽ†å²ç´¯è®¡å€¼è¯¯ç®—è¿›æœ¬æœŸé…é¢ã€‚
   75:  */
   76: export function calculateIncrement(current: bigint, last: bigint): bigint {
   77:     if (current < last) {
   78:         return 0n
   79:     }
   80:     return current - last
   81: }
   82: 
   83: /**
   84:  * è®¡ç®—æœ‰æ•ˆæµé‡é™é¢
   85:  * åŸºç¡€é™é¢ + é¢å¤–é…é¢
   86:  */
   87: export function getEffectiveLimit(limit: bigint | null, extraQuota: bigint): bigint | null {
   88:     if (limit === null) return null
   89:     return limit + extraQuota
   90: }
   91: 
   92: /**
   93:  * æ£€æŸ¥æ˜¯å¦è¶…è¿‡é™é¢
   94:  */
   95: export function isOverLimit(used: bigint, limit: bigint | null): boolean {
   96:     if (limit === null) return false
   97:     return used >= limit
   98: }
