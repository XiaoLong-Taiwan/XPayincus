  204: function getConfigSaveErrorMessage(err: any): string {
  205:   const details = typeof err?.details === 'string' ? err.details : ''
  240: async function loadConfigs() {
  241:   loading.value = true
  242:   try {
  243:     const response = await api.systemConfig.list()
  244: 
  245:     if (!response || typeof response !== 'object') {
  246:       console.warn('[SystemConfigView] Invalid response format:', response)
  247:       configs.value = []
  248:       return
  249:     }
  250: 
  251:     configs.value = Array.isArray(response.configs) ? response.configs : []
  252: 
  253:     // å¡«å……è¡¨å•
  254:     if (Array.isArray(response.configs)) {
  255:       for (const config of response.configs) {
  256:         if (config && typeof config === 'object' && config.key && config.key in form.value) {
  257:           try {
  258:             if (numericConfigKeys.includes(config.key)) {
  259:               (form.value as any)[config.key] = parseInt(config.value, 10) || 0
  260:             } else if (floatConfigKeys.includes(config.key)) {
  261:               (form.value as any)[config.key] = parseFloat(config.value) || 0
  262:             } else if (booleanConfigKeys.includes(config.key)) {
  263:               (form.value as any)[config.key] = config.value === 'true'
  264:             } else if (stringConfigKeys.includes(config.key)) {
  265:               (form.value as any)[config.key] = config.value || ''
  266:             } else if (jsonConfigKeys.includes(config.key)) {
  267:               try {
  268:                 (form.value as any)[config.key] = JSON.parse(config.value || '[]')
  269:               } catch {
  270:                 (form.value as any)[config.key] = []
  271:               }
  272:             }
  273:           } catch (configErr) {
  274:             console.error(`[SystemConfigView] Failed to process config key "${config.key}":`, configErr)
  275:           }
  276:         }
  277:       }
  278:     }
  279:   } catch (err: any) {
  280:     console.error('[SystemConfigView] Error loading configs:', err)
  281:     try {
  282:       toast.error((t('admin.system.loadFailed') || 'åŠ è½½é…ç½®å¤±è´¥') + ': ' + (err?.message || String(err)))
  283:     } catch (toastErr) {
  284:       console.error('[SystemConfigView] Failed to show toast:', toastErr)
  285:     }
  286:     // ç¡®ä¿configsæ˜¯ä¸€ä¸ªç©ºæ•°ç»„ï¼Œé¿å…åŽç»­ä»£ç å‡ºé”™
  287:     configs.value = []
  288:   } finally {
  289:     loading.value = false
  290:   }
  291: }
  292: 
  293: async function loadPopupPromoPackages() {
  294:   if (popupPromoPackagesLoading.value || popupPromoPackagesLoaded.value) {
  295:     return
  296:   }
  297:   popupPromoPackagesLoading.value = true
  298:   try {
  299:     const [officialResponse, marketResponse] = await Promise.all([
  300:       api.packages.list({ source: 'official' }),
  301:       api.packages.list({ source: 'market' })
  302:     ])
  303:     popupPromoPackages.value = [
  304:       ...(officialResponse.packages || []),
  305:       ...(marketResponse.packages || [])
  306:     ].filter(pkg => pkg.active === 1)
  307:     popupPromoPackagesLoaded.value = true
  308:   } catch (err) {
  309:     console.error('[SystemConfigView] Failed to load promo packages:', err)
  310:     popupPromoPackages.value = []
  311:   } finally {
  312:     popupPromoPackagesLoading.value = false
  313:   }
  314: }
  315: 
  316: // é€šç”¨ä¿å­˜å‡½æ•°
  317: async function saveConfigGroup(keys: string[], savingRef: { value: boolean }) {
  318:   savingRef.value = true
  319:   try {
  320:     const configsToUpdate = keys.map(key => ({
  321:       key,
  322:       value: jsonConfigKeys.includes(key)
  323:         ? JSON.stringify((form.value as any)[key] || [])
  324:         : typeof (form.value as any)[key] === 'boolean'
  325:           ? ((form.value as any)[key] ? 'true' : 'false')
  326:           : String((form.value as any)[key])
  327:     }))
  328: 
  329:     await api.systemConfig.update(configsToUpdate)
  330:     toast.success(t('admin.system.saveSuccess'))
  331:     await loadConfigs()
  332:   } catch (err: any) {
  333:     toast.error(t('admin.system.saveFailed') + ': ' + getConfigSaveErrorMessage(err))
  334:   } finally {
  335:     savingRef.value = false
  336:   }
  337: }
