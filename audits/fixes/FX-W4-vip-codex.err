assert.ok(
  lotterySource.includes('USER_RESOURCE_POOL_LOCK_NAMESPACE') &&
  lotterySource.includes('await advisoryTransactionLock(tx, USER_RESOURCE_POOL_LOCK_NAMESPACE, userId)') &&
