  305: async function executeRenewForUser(
  306:   user: { id: number; username: string },
  307:   instanceId: number,
  308:   months: number
  309: ): Promise<BatchRenewResultItem> {
  310:   const preview = await buildBatchRenewPreviewItem(user.id, instanceId)
  311:   if (!preview.canRenew) {
  312:     return {
  313:       id: preview.id,
  314:       name: preview.name,
  315:       success: false,
  316:       skipped: true,
  317:       reason: preview.reason
  318:     }
  319:   }
  320: 
  321:   const option = preview.options.find(item => item.months === months)
  322:   if (!option) {
  323:     return {
  324:       id: preview.id,
  325:       name: preview.name,
  326:       success: false,
  327:       skipped: true,
  328:       reason: 'è¯¥å®žä¾‹ä¸æ”¯æŒå½“å‰ç»­è´¹æ—¶é•¿'
  329:     }
  330:   }
  331: 
  332:   const instance = await prisma.instance.findUnique({
  333:     where: { id: instanceId }
  334:   })
  335: 
  336:   if (!instance || instance.userId !== user.id) {
  337:     return {
  338:       id: instanceId,
  339:       name: `#${instanceId}`,
  340:       success: false,
  341:       skipped: true,
  342:       reason: BATCH_HIDDEN_REASON
  343:     }
  344:   }
  345: 
  346:   if (instance.status === 'deleted') {
  347:     return {
  348:       id: instance.id,
  349:       name: instance.name,
  350:       success: false,
  351:       skipped: true,
  352:       reason: 'å®žä¾‹å·²åˆ é™¤ï¼Œæ— æ³•ç»­è´¹'
  353:     }
  354:   }
  355: 
  356:   try {
  357:     const result = await db.performRenewal(user.id, instance, months)
  358: 
  359:     await sendNotification(user.id, 'instance_renewed', {
  360:       instanceName: instance.name,
  361:       renewAmount: result.amount,
  362:       renewMonths: months,
  363:       newExpiresAt: result.newExpiresAt.toISOString()
  364:     })
  365: 
  366:     if (result.hostingIncomeResult) {
  367:       sendHostManagedInstanceNotification(
  368:         instance.hostId,
  369:         'renew',
  370:         {
  371:           username: user.username,
  372:           instanceName: instance.name,
  373:           amount: result.amount
  374:         }
  375:       ).catch(err => {
  376:         console.warn('[æ‰¹é‡ç»­è´¹] å‘é€æ‰˜ç®¡æ”¶å…¥é€šçŸ¥å¤±è´¥:', err)
  377:       })
  378:     }
  379: 
  380:     try {
  381:       const userInfo = await db.findUserById(user.id)
  382:       if (userInfo?.email) {
  383:         await sendRenewSuccessEmail(userInfo.email, {
  384:           username: userInfo.username,
  385:           instanceName: instance.name,
  386:           amount: result.amount,
  387:           months,
  388:           newExpiresAt: result.newExpiresAt
  389:         })
  390:       }
  391:     } catch (emailErr) {
  392:       console.warn('[æ‰¹é‡ç»­è´¹] å‘é€ç»­è´¹æˆåŠŸé‚®ä»¶å¤±è´¥:', emailErr)
  393:     }
  394: 
  395:     await createLog(
  396:       user.id,
  397:       'instance',
  398:       'instance.renew',
  399:       `Renewed instance "${instance.name}" for ${months} month(s), amount: ${result.amount}`,
