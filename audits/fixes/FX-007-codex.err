)

assert.ok(
  atomicMigrationScript.includes('current_link="$INSTALL_DIR/current"') &&
    atomicMigrationScript.includes('releases_dir="$INSTALL_DIR/releases"') &&
    atomicMigrationScript.includes('WorkingDirectory=${app_dir}') &&
