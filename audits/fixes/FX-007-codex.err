  101:       LogModule.SYSTEM,
  102:       'system.update.denied',
  103:       `Denied system update access for ${user.username}`,
  104:       LogResult.WARNING
  105:     )
  106:     reply.code(403).send({ error: 'Super administrator privileges required', code: 'SUPER_ADMIN_REQUIRED' })
  107:     return false
  108:   }
  109:   return true
  110: }
