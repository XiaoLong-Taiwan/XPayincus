map $http_upgrade $incudal_connection {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    server_name pay.example.org;
    ssl_certificate /etc/letsencrypt/live/pay.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pay.example.org/privkey.pem;
    client_max_body_size 304m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $incudal_connection;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl;
    server_name admin.example.org;
    ssl_certificate /etc/letsencrypt/live/admin.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.org/privkey.pem;
    client_max_body_size 304m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $incudal_connection;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
